<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="@dimen/message_bubble_image_default"
	android:layout_height="@dimen/message_bubble_image_default"
	tools:ignore="ContentDescription">

	<ImageView
		android:id="@+id/imageView"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:scaleType="centerCrop"
		tools:srcCompat="@tools:sample/avatars" />

	<LinearLayout
		android:id="@+id/voiceContainer"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingStart="8dp"
		android:paddingEnd="8dp"
		android:visibility="gone">

		<ImageButton
			android:id="@+id/voicePlayButton"
			android:layout_width="44dp"
			android:layout_height="44dp"
			android:background="?android:attr/selectableItemBackgroundBorderless"
			android:contentDescription="Play voice message"
			android:padding="10dp"
			android:src="@android:drawable/ic_media_play"
			android:tint="?android:attr/textColorPrimary" />

		<LinearLayout
			android:id="@+id/voiceWaveform"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingStart="4dp"
			android:paddingEnd="4dp">

			<View android:layout_width="2dp" android:layout_height="12dp" android:layout_marginEnd="2dp" android:background="?android:attr/textColorSecondary" />
			<View android:layout_width="2dp" android:layout_height="20dp" android:layout_marginEnd="2dp" android:background="?android:attr/textColorSecondary" />
			<View android:layout_width="2dp" android:layout_height="28dp" android:layout_marginEnd="2dp" android:background="?android:attr/textColorSecondary" />
			<View android:layout_width="2dp" android:layout_height="18dp" android:layout_marginEnd="2dp" android:background="?android:attr/textColorSecondary" />
			<View android:layout_width="2dp" android:layout_height="34dp" android:layout_marginEnd="2dp" android:background="?android:attr/textColorSecondary" />
			<View android:layout_width="2dp" android:layout_height="24dp" android:layout_marginEnd="2dp" android:background="?android:attr/textColorSecondary" />
			<View android:layout_width="2dp" android:layout_height="14dp" android:layout_marginEnd="2dp" android:background="?android:attr/textColorSecondary" />
			<View android:layout_width="2dp" android:layout_height="30dp" android:layout_marginEnd="2dp" android:background="?android:attr/textColorSecondary" />
			<View android:layout_width="2dp" android:layout_height="22dp" android:layout_marginEnd="2dp" android:background="?android:attr/textColorSecondary" />
			<View android:layout_width="2dp" android:layout_height="32dp" android:layout_marginEnd="2dp" android:background="?android:attr/textColorSecondary" />
			<View android:layout_width="2dp" android:layout_height="18dp" android:layout_marginEnd="2dp" android:background="?android:attr/textColorSecondary" />
			<View android:layout_width="2dp" android:layout_height="26dp" android:layout_marginEnd="2dp" android:background="?android:attr/textColorSecondary" />
			<View android:layout_width="2dp" android:layout_height="14dp" android:layout_marginEnd="2dp" android:background="?android:attr/textColorSecondary" />
			<View android:layout_width="2dp" android:layout_height="24dp" android:layout_marginEnd="2dp" android:background="?android:attr/textColorSecondary" />
			<View android:layout_width="2dp" android:layout_height="30dp" android:layout_marginEnd="2dp" android:background="?android:attr/textColorSecondary" />
			<View android:layout_width="2dp" android:layout_height="16dp" android:background="?android:attr/textColorSecondary" />
		</LinearLayout>

		<TextView
			android:id="@+id/voiceLabel"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="4dp"
			android:text="Voice message"
			android:textColor="?android:attr/textColorSecondary"
			android:textSize="12sp" />
	</LinearLayout>
</FrameLayout>
